{
  "name": "@uynil/agent-skills",
  "version": "0.2.0",
  "description": "Agent Skills repository compatible with agent-skills-cli.",
  "type": "module",
  "bin": {
    "skills": "./bin/skills.js"
  },
  "files": [
    "bin/**",
    "scripts/**",
    "skills/**",
    "README.md",
    "docs/**"
  ],
  "scripts": {
    "install:dev": "node bin/skills.js install-dev",
    "install:odoo": "node bin/skills.js install-odoo",
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate-skills.mjs"
  },
  "keywords": [
    "agent-skills",
    "skills",
    "codex",
    "kimi"
  ],
  "license": "MIT"
}
